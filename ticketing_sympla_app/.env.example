DJANGO_SECRET_KEY=replace-with-a-long-random-secret
SYMPLA_API_KEY=
SYMPLA_API_HOST=https://api.sympla.com.br/public/v1.6.0
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TRUST_PROXY=false
DJANGO_DOCS_ENABLED=true
DB_ENGINE=sqlite
# Production: DB_ENGINE=postgresql and configure DB_NAME, DB_USER, DB_PASSWORD,
# DB_HOST, DB_PORT=5432, DB_SSLMODE=verify-full and your trusted CA certificate.
